[Unit]
Description=Bot Discord VESPER (statut du serveur FiveM, joueurs, mises a jour)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vesperbot
Group=vesperbot
WorkingDirectory=/opt/vesper-discord-bot
EnvironmentFile=/opt/vesper-discord-bot/.env
# Le lanceur relance le bot apres une mise a jour (code 75) et revient a
# l'ancienne version si la nouvelle plante au demarrage.
ExecStart=/usr/bin/node lanceur.js
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Tout le dossier : le bot remplace lui-meme son code lors d'une mise a jour.
ReadWritePaths=/opt/vesper-discord-bot

[Install]
WantedBy=multi-user.target
