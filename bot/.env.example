# Copier en `.env` (droits 600) et remplir — install.sh le fait pour vous.
# ⚠️ Ne jamais publier le `.env`.
#
# Le reste (nom affiché, adresse, rôles, métiers, bienvenue) se règle depuis
# Discord avec /config : ces valeurs ne servent qu'au tout premier démarrage.

# Jeton du bot (portail développeur Discord → Bot → Reset Token).
DISCORD_TOKEN=
# Le serveur Discord du bot. Vide : il adopte celui où vous l'invitez.
GUILD_ID=
# L'adresse HTTP du serveur FiveM, vue depuis la machine du bot.
FIVEM_URL=http://127.0.0.1:30120
# Le même jeton que `set vesper_discord_jeton "…"` dans server.cfg.
VESPER_JETON=
# Secondes entre deux relevés du serveur FiveM (10 au minimum).
INTERVALLE=15

# Valeurs de départ, réglables ensuite avec /config :
# NOM_SERVEUR=          (vide : le nom du serveur FiveM)
# ADRESSE_CONNEXION=    (affichée pour F8 → connect …)
# CFX_JOIN=             (code cfx.re/join)
# STAFF_ROLE_IDS=       (ids de rôles, séparés par des virgules)
# ROLES_LECTURE=        (vide : salons publics visibles de tous)
# BIENVENUE=0

# Où chercher les mises à jour (dépôt GitHub public).
# DEPOT_MAJ=CedricPoint/vesper-discord-bot
