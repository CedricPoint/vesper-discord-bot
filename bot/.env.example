# Copier en `.env` (droits 600) et remplir. ⚠️ Ne jamais committer le `.env`.

# Jeton du bot (portail développeur Discord → Bot → Reset Token).
DISCORD_TOKEN=
# Le serveur Discord où le bot s'installe (il quitte tout autre serveur).
GUILD_ID=
# L'adresse HTTP du serveur FiveM, vue depuis la machine du bot.
FIVEM_URL=http://127.0.0.1:30120
# Le même jeton que `set vesper_discord_jeton "…"` dans server.cfg.
VESPER_JETON=
# Ce qu'on affiche aux joueurs pour se connecter (F8 → connect …).
ADRESSE_CONNEXION=
# Le code cfx.re/join (facultatif).
CFX_JOIN=
# Rôles du staff (ids séparés par des virgules) : salons privés et journaux.
STAFF_ROLE_IDS=
# Rôles qui voient les salons publics (vide = tout le monde).
ROLES_LECTURE=
# Secondes entre deux relevés du serveur FiveM (10 au minimum).
INTERVALLE=15
# 1 = message de bienvenue (exige l'intention « Server Members »).
BIENVENUE=0
